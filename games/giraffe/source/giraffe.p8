pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
t=true; f=false;
mv=t // is moving?
jm=f // jumping?
ground = 16; 

tm=0; wf=1;
dx,dy=0,0

ox=2.5 // offset of sprite
hx,hy=ox,16 // hero pos (real)
mx,my=0,0  // on map
cw,ch=8,8  // cell size

function init()
 hx,hy=ox,16
 dx,dy=0,0
end

function _update()
	if hy > 128 then init() end

 // map coordinates
 // todo: can span 2 cells
 mx,my=flr(hx/cw),flr(hy/ch)
 
 // gravity: og=on ground?
 og=mget(mx,my+1)==ground
 dy=dy+1 // gravity
 if og and (dy>0) then
  dy=0; hy=my*ch
  if(btn(❎)) dy=-6 //jump
 end

 // horizontal acceleration
 if(btn(⬅️)) dx=dx-0.4
 if(btn(➡️)) dx=dx+0.4
 dx=dx*0.8
 if(abs(dx)<0.1) dx=0

 // walk animation
 m=abs(dx)>0.2; tm=tm+1;
 if(tm%5==0) wf=1-wf
 hx=hx+dx; hy=hy+dy
end

function _draw()
 frm=1; if(m) frm=2+wf
 cls(0);
 map(0,0,0,0)
 print(mget(mx,my+1))
 // draw bounding box
// rect(mx*cw,my*ch,
//      mx*cw+cw,my*ch+ch,5)
 // flip when facing left
 fx=f;if(dx<0)fx=t
 spr(frm,hx-ox,hy,1,1,fx)
end
