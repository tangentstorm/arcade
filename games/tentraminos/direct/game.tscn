theme_override_font_sizes/font_size = 15
autowrap_mode = 3
text = "• rotate the cursor to re-arrange tiles
• score points by matching 4+ adjacent tiles of the same color
• groups light up when they're big enough
• every 10 seconds, when the clock reaches 0:
      – grouped tiles are removed and scored
      – a new line of random tiles is dropped
• arrows, w/a/s/d or h/t/c/n: move the cursor
• z/x, k/l, or o/j : rotate tiles within the cursor
• p: pause
• game is over when a tile in the top row blocks a random tile from falling.
      – careful! tiles in the cursor can block the falling tiles!
      – press Enter to restart
• Esc: menu / back to arcade"
